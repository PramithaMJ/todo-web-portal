# TODO Application - Environment Variables
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control!

# DATABASE CONFIGURATION
DB_NAME=tododb
DB_USER=todouser
DB_PASSWORD=change_this_secure_password_in_production
DB_PORT=5432
DB_HOST=postgres

# BACKEND CONFIGURATION
BACKEND_PORT=8080
SPRING_PROFILE=prod

# Database connection for Spring Boot
DATABASE_URL=jdbc:postgresql://postgres:5432/tododb
DATABASE_USERNAME=todouser
DATABASE_PASSWORD=change_this_secure_password_in_production

# JWT CONFIGURATION
# Generate secure key: openssl rand -base64 64
JWT_SECRET_KEY=YourVerySecureJWTSecretKeyHerePleaseChangeThisInProductionToAVeryLongAndRandomString==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# OAUTH2 - GOOGLE
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAUTH2 - GITHUB
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# FRONTEND CONFIGURATION
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# API URL (accessed by users' browsers)
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=30000
VITE_APP_ENV=production

# CORS & SECURITY
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTHORIZED_REDIRECT_URIS=http://localhost:3000/oauth2/redirect,http://localhost:5173/oauth2/redirect

# APPLICATION SETTINGS
LOG_LEVEL=info
ENABLE_SWAGGER=false
ENABLE_ACTUATOR_ENDPOINTS=true
